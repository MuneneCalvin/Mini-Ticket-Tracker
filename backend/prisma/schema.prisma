generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ticket {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      Status   @default(open)
  priority    Priority @default(medium)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("tickets")
}

enum Status {
  open
  in_progress
  closed
}

enum Priority {
  low
  medium
  high
}
